[
 {
  "do": "open",
  "viewport": "desktop",
  "storage": {
   "captains-academy:stars:long-beach-docking": "1",
   "captains-academy:stars:long-beach-crosswind": "1"
  }
 },
 {
  "do": "tap",
  "x": 60,
  "y": 262
 },
 {
  "do": "wait",
  "ms": 1500
 },
 {
  "do": "expect",
  "field": "level",
  "eq": 2
 },
 {
  "do": "expect",
  "field": "gates",
  "eq": 5
 },
 {
  "do": "screenshot",
  "name": "course-start"
 },
 {
  "do": "lever",
  "side": "port",
  "to": 50
 },
 {
  "do": "lever",
  "side": "starboard",
  "to": 50
 },
 {
  "do": "waitFor",
  "field": "yMm",
  "lt": 197000,
  "timeoutMs": 60000
 },
 {
  "do": "lever",
  "side": "port",
  "to": -80
 },
 {
  "do": "lever",
  "side": "starboard",
  "to": -80
 },
 {
  "do": "waitFor",
  "field": "speedMmPerS",
  "lt": 150,
  "timeoutMs": 30000
 },
 {
  "do": "key",
  "key": "x",
  "ms": 100
 },
 {
  "do": "screenshot",
  "name": "stopped-in-the-ship-lane"
 },
 {
  "do": "waitFor",
  "field": "outcome",
  "eq": "hit",
  "timeoutMs": 120000
 },
 {
  "do": "expect",
  "field": "struckBy",
  "eq": "container ship"
 },
 {
  "do": "screenshot",
  "name": "hit-by-the-ship"
 }
]